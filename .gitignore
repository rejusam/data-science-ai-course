# Your own work. Anything in here is yours and is never committed, so it can
# never conflict with course updates.
scratch/

# Your copies of the session notebooks. Copy a notebook in here before you type
# in it; then `git pull` can never refuse to run because of your own edits.
# The folder's own README is tracked so the folder arrives with the repository.
**/my-work/*
!**/my-work/README.md

# Secrets. If you ever commit one of these, treat the key as leaked and
# rotate it. Deleting it in a later commit does not remove it from history.
.env
.env.*
*.pem
*.key
credentials.json
service-account*.json

# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments. The environment is rebuilt from environment.yml,
# never committed.
.venv/
venv/
env/
.conda/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# Large data. Keep datasets under about 50 MB; GitHub rejects anything over
# 100 MB. Link to the source instead, or use the loader in the lab.
*.csv.gz
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.sqlite
*.db
*.zip
*.tar.gz

# Trained models
*.joblib
*.pt
*.pth
*.onnx
*.keras
saved_model/
checkpoints/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Course tooling. The build scripts, their tests and the report generators are
# the trainer's, not course material. They stay out of the published repository:
# a build script holds the same content as the notebook it writes, so an
# unpublished one is a spoiler in a second place that has to be remembered.
# Keeping the whole folder private removes that second place.
tools/

# --- Session materials held back until their class has run ---
# Untracked so students cannot read ahead; predict-before-you-run only works
# if the answer is not already on screen. These files still exist locally.
#
# To publish one after its session has run, delete its line below, then:
#     git add <path> && git commit && git push
# The slide map lists every section heading, including ones in notebooks that
# have not been taught yet. It goes out with the last notebook of the module.
modules/01a-programming-fundamentals/slide-map.md
modules/01a-programming-fundamentals/notebooks/04-code-quality-and-testing.ipynb
modules/01a-programming-fundamentals/pytest-demo/
